Rule 4     select_clause -> SELECT STAR
Rule 5     select_clause -> SELECT column_list
Rule 6     column_list -> ID
Rule 7     column_list -> column_list COMMA ID
Rule 8     from_clause -> FROM ID
Rule 9     condition -> ID EQ INT
Rule 10    condition -> ID EQ STRING
Rule 11    condition -> ID GT INT
Rule 12    condition -> ID LT INT
Rule 13    empty -> <empty>

